# Copy to .env and fill in before building.

# Public URL of the deployed site, no trailing slash. Used for canonical and Open Graph tags.
VITE_SITE_URL=https://your-domain.example

# Optional. A form endpoint that accepts JSON POSTs, such as a Formspree form URL
# (https://formspree.io/f/xxxxxxx). This URL is public by design; it is not a secret.
# Leave empty to have the contact form open the visitor's email app instead.
VITE_CONTACT_ENDPOINT=
